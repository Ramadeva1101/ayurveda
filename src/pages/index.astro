---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { Image } from 'astro:assets';

// Real clinic photos for the Why Choose Us tiles
import consultationImg from '../assets/images/awh-gallery/awh-03.webp';
import javaneseImg from '../assets/images/awh-gallery/awh-11.webp';
import dharaImg from '../assets/images/awh-gallery/awh-10.webp';

// Location photos (Bali Silent Retreat and the clinic rooms)
import bsrMountainsImg from '../assets/images/bsr-mountains.webp';
import room1Img from '../assets/images/room1.webp';
import room2Img from '../assets/images/room2.webp';
import bsrDroneImg from '../assets/images/bsr-drone-landscape.jpg';
import bsrJunglePathImg from '../assets/images/bsr-jungle-heart-path.jpg';
import bsrMeditationOctagonImg from '../assets/images/bsr-meditation-octagon.jpg';
import bsrLodgeLibraryImg from '../assets/images/bsr-lodge-library.jpg';
import bsrLabyrinthImg from '../assets/images/bsr-labyrinth.jpg';
import bsrDucksImg from '../assets/images/bsr-ducks-harvest.jpg';
import bsrStarGazingImg from '../assets/images/bsr-star-gazing.jpg';
import bsrFreshFoodImg from '../assets/images/bsr-fresh-food.jpg';

// Home and the former Our Sanctuary page are one page: Location & Stay.
// Section layout follows the client's demo (design 3); colours and fonts are
// the site's own. All wording comes from the existing pages.

// Same rounding as idrToApprox() on the packages page.
function idrToApprox(idrAmount: number) {
  const usd = Math.ceil(idrAmount / 16400 / 5) * 5;
  const aud = Math.ceil(idrAmount / 10600 / 5) * 5;
  const eur = Math.ceil(idrAmount / 17800 / 5) * 5;
  return `≈ USD ${usd.toLocaleString()} / AUD ${aud.toLocaleString()} / EUR ${eur.toLocaleString()}`;
}

const programs = [
  {
    name: '3-Day Ayurvedic & Javanese Energy Healing Experience',
    highlight: 'Perfect introduction to Ayurvedic healing.',
    amount: 5900000,
    image: '/images/rice field surrounding_11zon.webp',
    imageAlt: 'Rice field surroundings at Bali Silent Retreat',
    badge: null,
  },
  {
    name: '7-Day Ayurvedic Pancha Karma & Javanese Energy Healing Experience',
    highlight: 'Our most popular program.',
    amount: 15000000,
    image: '/images/meditation octagon bale_7_11zon.jpg',
    imageAlt: 'Meditation octagon bale at Bali Silent Retreat',
    badge: 'Most Popular',
  },
  {
    name: '14-Day Ayurvedic Deep Pancha Karma & Javanese Energy Healing Experience',
    highlight: 'Premium physician-led Pancha Karma and rejuvenation.',
    amount: 29000000,
    image: '/images/spectacular view of batukaru_11zon.webp',
    imageAlt: 'View of Mount Batukaru from Bali Silent Retreat',
    badge: null,
  },
];

// Location gallery (Bali Silent Retreat), wording from the former sanctuary page
const gallery = [
  { src: bsrDroneImg, alt: 'Aerial view of Bali Silent Retreat surrounded by rice fields and jungle', caption: 'Aerial View — 6 Hectares of Nature' },
  { src: bsrJunglePathImg, alt: 'Heart-shaped jungle path at Bali Silent Retreat', caption: 'Heart-Shaped Jungle Path' },
  { src: bsrMeditationOctagonImg, alt: 'Meditation octagon bale pavilion', caption: 'Meditation Octagon Bale' },
  { src: bsrLabyrinthImg, alt: 'Labyrinth walking meditation program', caption: 'Labyrinth Walking Meditation' },
  { src: bsrLodgeLibraryImg, alt: 'Lodge library relaxation area', caption: 'Library & Relaxation Lodge' },
  { src: bsrDucksImg, alt: 'Eco-friendly ducks after rice harvest at Bali Silent Retreat', caption: 'Eco-Friendly Life — Ducks After Rice Harvest' },
  { src: bsrStarGazingImg, alt: 'Star gazing on star bed at dusk', caption: 'Star Gazing at Dusk' },
  { src: bsrFreshFoodImg, alt: 'Fresh wholesome food at the retreat', caption: 'Fresh Wholesome Food' },
];

const bsrUrl = 'https://www.balisilentretreat.com/';
const waConsultUrl = 'https://wa.me/6285926461359?text=Hello%2C%20I%20would%20like%20to%20book%20a%20consultation%20with%20Dr.%20Komang.';
const mapsUrl = 'https://maps.app.goo.gl/gRzEuCPrURoJJ8rG8';

// Matches the service slugs in Admin > Services, so /book opens with it selected
const slugify = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<BaseLayout
  title="Authentic Ayurveda in Bali"
  description="Experience authentic Ayurveda in Bali through personalized consultations, traditional Ayurvedic massage, and wellness therapies led by Dr. Komang Sudarmi."
>
  <Navbar />

  <main id="main-content" class="home">

    <!-- Hero: full-bleed photo -->
    <section class="hero">
      <div class="hero__image" aria-hidden="true"></div>
      <div class="hero__shade" aria-hidden="true"></div>
      <div class="hero__content">
        <h1 class="hero__title">Authentic Ayurveda in Bali, In combination with Javanese energy healing therapy</h1>
        <div class="actions">
          <a href="https://wa.me/6285926461359?text=Hello%2C%20I%20would%20like%20to%20book%20a%20consultation%20with%20Dr.%20Komang." target="_blank" rel="noopener noreferrer" class="btn btn-primary">Book Consultation</a>
          <a href="/program" class="btn btn-secondary">Explore Programs</a>
        </div>
      </div>
    </section>

    <!-- 01 Two places (copy supplied by the client in the demo) -->
    <section class="chapter">
      <div class="container narrow center">
        <p class="chapter__num">01</p>
        <p class="eyebrow eyebrow--lined">Two separate places, close together</p>
        <h2 class="display display--xl">Ayurvedic healing is not only about the treatments you receive. It is also about the environment around you.</h2>
        <p class="lead">
          Ayurvedic Wellness House and Bali Silent Retreat are separate establishments located close to one another. We provide Ayurvedic consultations, treatments, and wellness programs. If you are visiting us over several days, Bali Silent Retreat offers nearby accommodation that can complement your time with us.
        </p>
      </div>
    </section>

    <!-- 02 Where your care happens (copy supplied by the client in the demo) -->
    <section class="chapter chapter--alt">
      <div class="container care">
        <div class="care__text">
          <p class="chapter__num">02</p>
          <p class="eyebrow eyebrow--lined">Ayurvedic Wellness House</p>
          <h2 class="display display--xl display--left">Where your care happens</h2>
          <p class="lead lead--left">Consultations with Dr. Komang, Ayurvedic treatments, Javanese energy healing and our wellness programs all take place at the Wellness House in Tabanan.</p>
          <ul class="care__list">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 3 4 8 5-5 5 15H2L8 3z"></path></svg>
              Spectacular views of Mount Batukaru
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20c0-6 2-10 2-16"></path><path d="M9 20c0-6 1.5-10 1.5-14"></path><path d="M14 20c0-5 1.5-9 1.5-12"></path><path d="M19 20c0-4 1-7 1-9"></path></svg>
              Peaceful rice field surroundings
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h11a3 3 0 1 0-3-3"></path><path d="M3 12h16a3 3 0 1 1-3 3"></path><path d="M3 16h8"></path></svg>
              Fresh mountain air
            </li>
          </ul>
          <div class="actions">
            <a href="/program" class="btn btn-outline">See our treatments</a>
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Get directions</a>
          </div>
        </div>
        <div class="care__photos">
          <figure>
            <Image src={room1Img} alt="Spa room at Ayurvedic Wellness House" width={640} loading="lazy" />
            <figcaption>Wellness House · spa room</figcaption>
          </figure>
          <figure>
            <Image src={room2Img} alt="Steam room at Ayurvedic Wellness House" width={640} loading="lazy" />
            <figcaption>Wellness House · steam room</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 03 Why Choose Us: photo tiles -->
    <section class="chapter">
      <div class="container">
        <p class="chapter__num">03</p>
        <h2 class="display display--xl display--left">Why Choose Us</h2>
        <div class="tiles">
          <article class="tile">
            <Image src={consultationImg} alt="Consultation at Ayurvedic Wellness House" width={720} loading="lazy" class="tile__photo" />
            <div class="tile__body">
              <span class="tile__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 20h10"></path>
                  <path d="M12 20v-8"></path>
                  <path d="M12 12a5 5 0 0 0-5-5H3"></path>
                  <path d="M12 14a5 5 0 0 1 5-5h4"></path>
                </svg>
              </span>
              <h3 class="tile__title">Authentic Ayurveda</h3>
              <p class="tile__text">Led by Dr. Komang Sudarmi — a licensed Ayurvedic physician with over a decade of clinical practice.</p>
            </div>
          </article>
          <article class="tile">
            <Image src={javaneseImg} alt="Javanese energy healing session" width={720} loading="lazy" class="tile__photo" />
            <div class="tile__body">
              <span class="tile__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 3.5 1 8a8.5 8.5 0 0 1-9 10z"></path>
                  <path d="M19 2c-2.26 4.33-5.27 7.14-8 8"></path>
                </svg>
              </span>
              <h3 class="tile__title">Javanese energy healing therapy</h3>
              <p class="tile__text">Combining the Javanese energy healing therapy with authentic Ayurvedic protocols.</p>
            </div>
          </article>
          <article class="tile">
            <Image src={dharaImg} alt="Dhara therapy at Ayurvedic Wellness House" width={720} loading="lazy" class="tile__photo" />
            <div class="tile__body">
              <span class="tile__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                </svg>
              </span>
              <h3 class="tile__title">Personalized Programs</h3>
              <p class="tile__text">Every treatment plan begins with a consultation to understand your unique constitution and needs.</p>
            </div>
          </article>
          <article class="tile">
            <Image src={bsrMountainsImg} alt="Mountains and rice fields near Bali Silent Retreat" width={720} loading="lazy" class="tile__photo" />
            <div class="tile__body">
              <span class="tile__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m8 3 4 8 5-5 5 15H2L8 3z"></path>
                  <path d="M12 21v-4"></path>
                </svg>
              </span>
              <h3 class="tile__title">Natural Healing</h3>
              <p class="tile__text">Set near by <a href={bsrUrl} target="_blank" rel="noopener noreferrer">Bali Silent Retreat</a> — surrounded by rice fields, tropical forests, all-day buffet fresh foods daily and Mount Batukaru views.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 04 How booking works. Step titles come from the Book page; the short
         descriptions match what the booking system actually does. -->
    <section class="chapter how">
      <div class="container how__grid">
        <div class="how__intro">
          <p class="chapter__num">04</p>
          <p class="eyebrow eyebrow--lined">Book your visit</p>
          <h2 class="display display--xl display--left">Reserve your time with us</h2>
          <div class="actions">
            <a href="/book" class="btn btn-primary">Book now</a>
            <a href={waConsultUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Start Consultation</a>
          </div>
        </div>

        <ol class="how__steps">
          <li class="how__step">
            <span class="how__num">1</span>
            <div>
              <h3 class="how__title">Send your request</h3>
              <p class="how__text">Choose a treatment or program, pick a date and time, and answer a few health questions.</p>
            </div>
          </li>
          <li class="how__step">
            <span class="how__num">2</span>
            <div>
              <h3 class="how__title">We confirm on WhatsApp</h3>
              <p class="how__text">We check the schedule and confirm your booking on WhatsApp. You also receive the details by email.</p>
            </div>
          </li>
          <li class="how__step">
            <span class="how__num">3</span>
            <div>
              <h3 class="how__title">Come on your booked date</h3>
              <p class="how__text">Come to Ayurvedic Wellness House in Tabanan at your booked time.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- 05 Wellness programs -->
    <section class="chapter">
      <div class="container">
        <p class="chapter__num">05</p>
        <p class="eyebrow eyebrow--lined">Ayurvedic rejuvenation &amp; panchakarma programs</p>
        <h2 class="display display--xl display--left">Our Wellness Programs</h2>
        <p class="lead lead--left">Each program is designed around a specific wellness goal — from a single day to 21 days of deep classical Pancha Karma.</p>
        <div class="program-grid">
          {programs.map((p) => (
            <article class="program">
              <div class="program__photo">
                <img src={p.image} alt={p.imageAlt} loading="lazy" decoding="async" />
                {p.badge && <span class="program__badge">{p.badge}</span>}
              </div>
              <div class="program__body">
                <h3 class="program__name">{p.name}</h3>
                <p class="program__highlight">{p.highlight}</p>
                <div class="price-regular">
                  <p class="program__price">IDR {p.amount.toLocaleString('en-US')}++</p>
                  <p class="program__approx">{idrToApprox(p.amount)}</p>
                </div>
                <div class="price-offer" data-amount={p.amount}>
                  <p class="program__was">IDR {p.amount.toLocaleString('en-US')}++</p>
                  <p class="program__price"><span class="price-amount"></span> <span class="offer-tag"></span></p>
                  <p class="program__approx price-approx"></p>
                </div>
                <div class="program__actions">
                  <a href={`/book?service=${slugify(p.name)}`} class="btn btn-primary">Book now</a>
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="center more">
          <a href="/packages" class="btn btn-outline">View Wellness Programs</a>
        </div>
      </div>
    </section>

    <!-- Location & Stay (wording from the former sanctuary page) -->
    <section class="chapter chapter--alt" id="location-stay">
      <div class="container">
        <div class="loc">
          <div class="loc__intro">
            <p class="eyebrow eyebrow--lined">Location &amp; Stay</p>
            <h2 class="display display--lg display--left">A Sanctuary Beyond Words</h2>
            <p class="lead lead--left">Immerse yourself in 6 hectares of nature — where rice fields, jungle, and mountain air create the perfect backdrop for healing.</p>
          </div>
          <dl class="loc__facts">
            <div class="loc__fact">
              <dt>Rooms</dt>
              <dd><a href="https://www.balisilentretreat.com/accommodation/" target="_blank" rel="noopener noreferrer">5 types of rooms with 5 prices</a></dd>
            </div>
            <div class="loc__fact">
              <dt>Food</dt>
              <dd>delicious, organic, freshly picked <a href="https://www.balisilentretreat.com/food/" target="_blank" rel="noopener noreferrer">All-Day-Buffet</a></dd>
            </div>
            <div class="loc__fact">
              <dt>Activities</dt>
              <dd><a href="https://www.balisilentretreat.com/programs/" target="_blank" rel="noopener noreferrer">20+ activities</a>: nature, movement, meditation, and self-reflective activities, such as a labyrinth, jogging track, sound bath, curated jungle walk</dd>
            </div>
          </dl>
        </div>
        <div class="gallery">
          {gallery.map((g) => (
            <figure class="gallery__item">
              <Image src={g.src} alt={g.alt} width={640} loading="lazy" />
              <figcaption>{g.caption}</figcaption>
            </figure>
          ))}
        </div>
        <div class="note">
          <p><strong>Note:</strong> For accommodation and meal bookings, please visit</p>
          <a href={bsrUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Bali Silent Retreat</a>
        </div>
      </div>
    </section>

    <!-- Closing CTA over a full-bleed photo -->
    <section class="banner cta-photo" style="--banner-bg: url('/images/bg.webp')">
      <div class="banner__shade" aria-hidden="true"></div>
      <div class="container banner__inner center">
        <h2 class="display display--xl">Begin Your Healing Journey</h2>
        <p class="lead">
          Whether you seek relief from specific health concerns, a deep detox, or simply a renewed sense of balance — we are here to guide you.
        </p>
        <div class="actions actions--center">
          <a href="/book" class="btn btn-primary">Book now</a>
          <a href="https://wa.me/6285926461359?text=Hello%2C%20I%20would%20like%20to%20book%20a%20consultation%20with%20Dr.%20Komang." target="_blank" rel="noopener noreferrer" class="btn btn-outline">Start Consultation</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <FloatingWhatsApp />

  <script is:inline>
    // Same package offer as the packages page (Admin > Settings via /api/offer.php).
    (function () {
      function approx(idr) {
        var up = function (v) { return Math.ceil(v / 5) * 5; };
        return '≈ USD ' + up(idr / 16400).toLocaleString() + ' / AUD ' + up(idr / 10600).toLocaleString() + ' / EUR ' + up(idr / 17800).toLocaleString();
      }
      fetch('/api/offer.php').then(function (r) { return r.json(); }).then(function (o) {
        if (!o || !o.percent) return;
        var until = new Date(o.until + 'T00:00:00');
        var month = until.toLocaleDateString('en-GB', { month: 'long' });
        document.querySelectorAll('.price-offer[data-amount]').forEach(function (el) {
          var price = Math.round(Number(el.dataset.amount) * (100 - o.percent) / 100);
          el.querySelector('.offer-tag').textContent = o.percent + '% off until ' + until.getDate() + ' ' + month;
          el.querySelector('.price-amount').textContent = 'IDR ' + price.toLocaleString('en-US') + '++';
          el.querySelector('.price-approx').textContent = approx(price);
        });
        document.documentElement.classList.add('offer-on');
      }).catch(function () {});
    })();
  </script>
</BaseLayout>

<style>
  .home {
    background: var(--color-cream-base);
    color: var(--color-olive);
  }

  /* ---------- shared ---------- */
  .chapter {
    padding: clamp(4rem, 9vw, 8rem) 0;
  }

  .chapter--alt {
    background: var(--color-cream-deep);
  }

  .narrow {
    max-width: 60rem;
  }

  .center {
    text-align: center;
  }

  .chapter__num {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 2rem;
    font-weight: 500;
    line-height: 1;
    color: var(--color-gold);
    margin: 0 0 1rem;
  }

  .eyebrow {
    font-family: 'Karla', sans-serif;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-gold-dark);
    margin: 0 0 1.25rem;
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  /* Short gold rule before the label, as in the demo */
  .eyebrow--lined::before {
    content: '';
    display: inline-block;
    width: 2rem;
    height: 1px;
    margin-right: 0.75rem;
    vertical-align: middle;
    background: currentColor;
  }

  .eyebrow--light {
    color: var(--color-gold-light);
  }

  .display {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-olive);
    margin: 0 0 1.5rem;
  }

  .display--xl {
    font-size: clamp(2.25rem, 1.3rem + 4vw, 4.5rem);
  }

  .display--lg {
    font-size: clamp(1.9rem, 1.2rem + 2.8vw, 3.5rem);
  }

  .display--md {
    font-size: clamp(1.6rem, 1.15rem + 1.8vw, 2.5rem);
  }

  .display--left {
    text-align: left;
  }

  .display--light {
    color: var(--color-cream-base);
  }

  .lead {
    font-size: clamp(1.05rem, 0.95rem + 0.35vw, 1.25rem);
    font-weight: 500;
    line-height: 1.75;
    color: var(--color-olive);
    opacity: 0.85;
    max-width: 46rem;
    margin: 0 auto;
  }

  .lead--left {
    margin: 0 0 2.5rem;
  }

  .more {
    margin-top: 2.5rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .actions--center {
    justify-content: center;
    margin-top: 2rem;
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    font-family: 'Karla', sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    border-radius: 0.125rem;
    border: 2px solid var(--color-sage);
    background-color: transparent;
    color: var(--color-olive);
    cursor: pointer;
    transition: all 0.25s ease;
    text-decoration: none;
  }

  .btn-outline:hover {
    background-color: var(--color-sage);
    color: white;
  }

  /* ---------- hero: full-bleed photo ---------- */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #36521f;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    background: url('/images/bg.webp') center / cover no-repeat;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(16, 24, 13, 0.5) 0%, rgba(16, 24, 13, 0.15) 55%, rgba(16, 24, 13, 0) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 8rem clamp(1.25rem, 5vw, 4rem) 4rem;
  }

  .hero__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(2.25rem, 1.25rem + 4.5vw, 4.5rem);
    /* 500 italic is the heaviest italic loaded; higher weights get faked bold */
    font-weight: 500;
    font-style: italic;
    color: var(--color-cream-base);
    line-height: 1.12;
    max-width: 18ch;
    margin: 0 0 2rem;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.3);
  }

