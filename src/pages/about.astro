---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import SectionDivider from '../components/SectionDivider.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import drKomangImg from '../assets/images/dr-komang-portrait.webp';
import ajiImg from '../assets/images/aji-portrait.webp';
import therapistImg from '../assets/images/therapist-portrait.webp';
import logoImg from '../assets/images/logo.png';
import niceTourLogoImg from '../assets/images/nicetourbali-logo.webp';
import niceTourTeamImg from '../assets/images/nicetourbali-team.webp';

const niceTourUrl = 'https://nicetourbali.com/';

const partnerServices = [
  { label: 'Airport Transfers', icon: 'plane' },
  { label: 'Private Transportation', icon: 'car' },
  { label: 'Accommodation Arrangements', icon: 'bed' },
  { label: 'Hotel & Wellness Centre Transfers', icon: 'route' },
  { label: 'Pre & Post-Retreat Arrangements', icon: 'calendar' },
  { label: 'Private Bali Tours', icon: 'camera' },
];
---

<BaseLayout
  title="About Us"
  description="Meet Dr. Komang Sudarmi, Ayurvedic Physician and Founder of Ayurvedic Wellness House, and our team of trained therapists."
>
  <Navbar />

  <main id="main-content">

    <!-- Page Hero -->
    <PageHero
      eyebrow="About Us"
      title="The People &amp;&nbsp;Philosophy<br/>Behind Our Healing"
      subtitle="Rooted in ancient wisdom, guided by compassionate care."
      image="/images/about-bg.webp"
      imageAlt="Ayurvedic practitioner welcoming you next to a treatment table"
      height="68vh"
      bottomColor="#FAF6F0"
    />

    <!-- Our Uniqueness Section -->
    <section class="uniqueness section">
      <div class="container">
        <p class="section-eyebrow">Our Uniqueness</p>
        <h2 class="uniqueness__title">Where Two Ancient Healing Traditions Meet</h2>
        <p class="uniqueness__lead">At Ayurvedic Wellness House, we bring together the timeless wisdom of Classical Ayurveda and the rich heritage of Javanese Energy Healing Therapy to create a complete personalized wellness experience.</p>

        <div class="uniqueness-grid">

          <!-- Ayurveda -->
          <div class="uniqueness-card">
            <div class="uniqueness-card__icon">
              <!-- Leaf/herb icon — represents Ayurveda (Science of Life, healing herbs) -->
              <svg viewBox="0 0 24 24" fill="none" stroke="#B8935A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"></path>
                <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
              </svg>
            </div>
            <h3 class="uniqueness-card__title">What is Ayurveda?</h3>
            <div class="uniqueness-card__divider"></div>
            <p class="uniqueness-card__text">
              Ayurveda, meaning <em>"The Science of Life,"</em> is a traditional medical system from India with over 5,000 years of history. It focuses on restoring balance through personalized consultation, healing herbs, therapeutic treatments, nutrition, and healthy lifestyle practices.
            </p>
            <p class="uniqueness-card__text">
              Rather than treating symptoms alone, Ayurveda aims to support the body's natural ability to heal and maintain long-term well-being.
            </p>
          </div>

          <!-- Nusantara -->
          <div class="uniqueness-card">
            <div class="uniqueness-card__icon">
              <!-- Waves/archipelago icon — represents Nusantara (Indonesian island heritage) -->
              <svg viewBox="0 0 24 24" fill="none" stroke="#B8935A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"></path>
                <path d="M2 12c.6.5 1.2 1 2.5 1C7 13 7 11 9.5 11c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"></path>
                <path d="M2 18c.6.5 1.2 1 2.5 1C7 19 7 17 9.5 17c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"></path>
              </svg>
            </div>
            <h3 class="uniqueness-card__title">What is Javanese Energy Healing therapy?</h3>
            <div class="uniqueness-card__divider"></div>
            <p class="uniqueness-card__text">
              Traditional Point Pressure techniques of Javanese healing heritage, developed over generations practised locally.
            </p>
            <p class="uniqueness-card__text">
              It emphasizes harmony between the body, mind, nature, and spirit — reflecting the diverse wisdom found throughout the Indonesian archipelago.
            </p>
          </div>

          <!-- Why Combine -->
          <div class="uniqueness-card uniqueness-card--highlight">
            <div class="uniqueness-card__icon">
              <!-- Merge/infinity icon — represents combining two traditions into one holistic path -->
              <svg viewBox="0 0 24 24" fill="none" stroke="#B8935A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18.178 8c5.096 0 5.096 8 0 8-5.095 0-7.133-8-12.739-8-4.585 0-4.585 8 0 8 5.606 0 7.644-8 12.74-8z"></path>
              </svg>
            </div>
            <h3 class="uniqueness-card__title">Why Combine Both?</h3>
            <div class="uniqueness-card__divider"></div>
            <p class="uniqueness-card__text">
              Although they come from different cultures, both traditions share the same philosophy. By combining them, we create a unique healing experience that is deeply personalized</p>
            <ul class="uniqueness-list"><li>Treat the whole person, physically</li><li>Use therapeutic point pressure impact in release the tension instantly</li><li>Support the body's own healing process</li><li>Encourage a healthy lifestyle for lasting wellness</li></ul>
          </div>

        </div>
      </div>
    </section>

    <SectionDivider />

    <!-- Meet Our People Section -->
    <section class="meet-people section">
      <div class="container">
        <h2 class="meet-people__title">Meet Our People</h2>
      </div>
    </section>

    <SectionDivider variant="simple" />

    <!-- Dr. Komang — Large, Prominent Founder Profile -->
    <section class="founder section section--alt">
      <div class="container">
        <div class="founder-inner">
          <div class="founder-portrait">
            <div class="founder-portrait__image">
              <Image
                src={drKomangImg}
                alt="Dr. Komang Sudarmi, Founder & Chief Ayurvedic Physician"
                class="founder-portrait__img"
                width={600}
              />
            </div>
          </div>

          <div class="founder-bio">
            <p class="founder-title">Dr. Komang Sudarmi, BAMS., MS., PhD (Ayurveda)</p>
            <p class="founder-role">Founder &amp; Chief Ayurvedic Physician</p>
            <div class="founder-divider" aria-hidden="true"></div>

            <p class="founder-text">
              Dr. Komang Sudarmi is an internationally trained Ayurvedic physician with over 11 years of formal education in Ayurveda University in India, more than five years being residents at ayurvedic hospital in India and experienced more that 6 years as an Ayurvedic Consultant at Wellnesses in Bali. She earned her Bachelor's, Master's, and PhD in Ayurveda in India — the birthplace of this ancient healing science.</p>
            <p class="founder-text">
              As the founder of Ayurvedic Wellness House, Dr. Komang integrates authentic Ayurvedic wisdom with the Javanese energy healing therapy to provide personalized wellness programs that harmonized the physical, mind, and spirit. Her approach combines evidence-based Ayurvedic principles with compassionate, individualized care, creating transformative healing experiences for every guest.</p>
            <p class="founder-text">
              Driven by a vision to share an authentic Ayurvedic combine with Javanese’s healing wisdom to Indonesia and the world, Dr. Komang is dedicated to helping people achieve lasting health through natural, holistic healing.</p>
            <a href="https://wa.me/6285926461359?text=Hello%2C%20I%20would%20like%20to%20book%20a%20consultation%20with%20Dr.%20Komang." target="_blank" rel="noopener noreferrer" class="founder-cta">
              Book a consultation with Dr. Komang
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <SectionDivider variant="simple" />

    <!-- Team Section -->
    <section class="team section">
      <div class="container">
        <div class="team-grid">

          <!-- Aji — Javanese Healer -->
          <div class="team-member">
            <div class="member-portrait">
              <Image
                src={ajiImg}
                alt="Aji, Javanese Healer"
                class="member-portrait__img"
                width={400}
              />
            </div>
            <div class="member-info">
              <p class="member-label">JAVANESE HEALER</p>
              <p class="member-name">Aji</p>
              <div class="member-divider" aria-hidden="true"></div>
              <p class="member-text">
                Aji is a devoted Javanese traditional healer and experienced point pressure therapist, born in Solo and deeply rooted in Traditional Javanese's healing heritage. Guided by the sacred discipline of traditional healer lineage, Aji embodies self-discipline, presence, and compassion in every treatment. His approach is designed to restore harmony, release tension, and support the body's natural healing process — offering guests a deeply grounding and rejuvenating wellness experience.</p>
            </div>
          </div>

          <!-- Trained Ayurvedic Therapist -->
          <div class="team-member">
            <div class="member-portrait">
              <Image
                src={therapistImg}
                alt="Our Trained Ayurvedic Therapist"
                class="member-portrait__img"
                width={400}
              />
            </div>
            <div class="member-info">
              <p class="member-label">TRAINED AYURVEDIC THERAPIST</p>
              <p class="member-name">Our Therapist</p>
              <div class="member-divider" aria-hidden="true"></div>
              <p class="member-text">
                Trained by Doc K, our Ayurvedic therapists bring dedication, skill, and warmth to every session. Each therapist has completed rigorous training under Dr. Komang Sudarmi's guidance, ensuring every treatment meets the highest standards of authentic Ayurvedic practice. They work alongside Dr. Komang to deliver personalized healing experiences rooted in classical Ayurvedic principles and the healing wisdom of Nusantara.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <SectionDivider variant="simple" />

    <!-- Local Partner — Nice Tour Bali -->
    <section class="partner section" aria-labelledby="partner-title">
      <div class="container">
        <div class="partner-eyebrow">
          <svg class="partner-eyebrow__lotus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20c-2.5-2-4-4.6-4-8s1.5-6 4-8c2.5 2 4 4.6 4 8s-1.5 6-4 8z" />
            <path d="M12 20c-3.5 0-7-2.5-8-7 2.5-.5 5 .2 6.5 2" />
            <path d="M12 20c3.5 0 7-2.5 8-7-2.5-.5-5 .2-6.5 2" />
          </svg>
          <p class="partner-eyebrow__text">Our Local Partner</p>
        </div>
        <h2 class="partner__title" id="partner-title">Your Journey in Bali, Taken Care Of</h2>
        <p class="partner__lead">
          We work with a trusted local partner to support our guests with travel and ground arrangements, so you can focus on your wellness journey.
        </p>

        <div class="partner-inner">
          <div class="partner-content">
            <div class="partner-brands">
              <div class="partner-brands__item">
                <Image src={logoImg} alt="Ayurvedic Wellness House" class="partner-brands__awh" width={360} />
                <span class="partner-brands__caption">Ayurveda &amp; Wellness</span>
              </div>
              <span class="partner-brands__x" aria-hidden="true">&times;</span>
              <a href={niceTourUrl} target="_blank" rel="noopener" class="partner-brands__item">
                <Image src={niceTourLogoImg} alt="Nice Tour Bali" class="partner-brands__nice-img" />
                <span class="partner-brands__caption">Local Ground Arrangement Partner</span>
              </a>
            </div>

            <p class="partner-text">
              We work with <a href={niceTourUrl} target="_blank" rel="noopener">Nice Tour Bali</a> as our local ground arrangement partner in Bali. Their experienced local team assists our guests with transportation, accommodation and other travel services before, during and after your wellness program.
            </p>

            <h3 class="partner-services__title">Ground Arrangement Services</h3>
            <ul class="partner-services">
              {partnerServices.map((service) => (
                <li class="partner-service">
                  <span class="partner-service__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      {service.icon === 'plane' && (
                        <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z" />
                      )}
                      {service.icon === 'car' && (
                        <>
                          <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9L18.4 10.6 16.3 7.3c-.4-.5-1-.8-1.6-.8H7.6c-.7 0-1.3.4-1.7.9L4 10.3 2.8 11c-.5.3-.8.9-.8 1.5V16c0 .6.4 1 1 1h2" />
                          <circle cx="7" cy="17" r="2" />
                          <path d="M9 17h6" />
                          <circle cx="17" cy="17" r="2" />
                        </>
                      )}
                      {service.icon === 'bed' && (
                        <>
                          <path d="M2 4v16" />
                          <path d="M2 8h18a2 2 0 0 1 2 2v10" />
                          <path d="M2 17h20" />
                          <path d="M6 8v9" />
                        </>
                      )}
                      {service.icon === 'route' && (
                        <>
                          <circle cx="6" cy="19" r="3" />
                          <path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15" />
                          <circle cx="18" cy="5" r="3" />
                        </>
                      )}
                      {service.icon === 'calendar' && (
                        <>
                          <rect x="3" y="4" width="18" height="18" rx="2" />
                          <path d="M16 2v4" />
                          <path d="M8 2v4" />
                          <path d="M3 10h18" />
                          <path d="m9 16 2 2 4-4" />
                        </>
                      )}
                      {service.icon === 'camera' && (
                        <>
                          <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z" />
                          <circle cx="12" cy="13" r="3" />
                        </>
                      )}
                    </svg>
                  </span>
                  <span class="partner-service__label">{service.label}</span>
                </li>
              ))}
            </ul>

            <a href={niceTourUrl} target="_blank" rel="noopener" class="btn btn-primary partner-cta">
              Visit Nice Tour Bali
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>

          <figure class="partner-photo">
            <Image
              src={niceTourTeamImg}
              alt="The Nice Tour Bali team in black nicetourbali.com T-shirts, standing on a garden lawn in Bali"
              class="partner-photo__img"
              width={720}
            />
          </figure>
        </div>

        <div class="partner-band">
          <div class="partner-band__brands">
            <div class="partner-brands__item">
              <Image src={logoImg} alt="Ayurvedic Wellness House" class="partner-band__awh" width={300} />
              <span class="partner-brands__caption">Ayurveda &amp; Wellness</span>
            </div>
            <span class="partner-band__plus" aria-hidden="true">+</span>
            <a href={niceTourUrl} target="_blank" rel="noopener" class="partner-brands__item">
              <Image src={niceTourLogoImg} alt="Nice Tour Bali" class="partner-band__nice" />
              <span class="partner-brands__caption">Ground Arrangements</span>
            </a>
          </div>
          <p class="partner-band__text">
            Wellness care and local travel support for a smoother stay in Bali.
          </p>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <FloatingWhatsApp />
</BaseLayout>

<style>
  .page-header {
    background-color: var(--color-cream-base);
    padding-top: clamp(6rem, 12vw, 10rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
    text-align: center;
  }

  .page-eyebrow {
    font-family: 'Karla', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }

  .page-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(2.25rem, 1.5rem + 3.5vw, 4rem);
    font-weight: 400;
    color: var(--color-olive);
    max-width: 22ch;
    margin: 0 auto 1.25rem;
    line-height: 1.15;
  }

  .page-subtitle {
    font-family: 'Karla', sans-serif;
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.125rem);
    color: var(--color-olive);
    opacity: 0.65;
    max-width: 36ch;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Founder Section */
  .founder-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .founder-inner {
      grid-template-columns: 5fr 7fr;
      gap: 5rem;
      align-items: center;
    }
  }

  .founder-portrait__image .img-placeholder,
  .founder-portrait__img {
    aspect-ratio: 4 / 5;
    width: 100%;
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  .founder-bio {
    order: -1;
  }

  @media (min-width: 1024px) {
    .founder-bio {
      order: 0;
    }
  }

  .founder-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.25rem, 1rem + 1.5vw, 1.75rem);
    font-weight: 500;
    color: var(--color-olive);
    margin-bottom: 0.25rem;
    line-height: 1.3;
  }

  .founder-role {
    font-family: 'Karla', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    margin-bottom: 1.5rem;
  }

  .founder-divider {
    width: 3rem;
    height: 1px;
    background-color: var(--color-gold);
    margin-bottom: 1.5rem;
  }

  .founder-text {
    font-size: clamp(1rem, 0.9375rem + 0.25vw, 1.0625rem);
    color: var(--color-olive);
    opacity: 0.85;
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .founder-text:last-of-type {
    margin-bottom: 0;
  }

  .founder-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Karla', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-sage);
    margin-top: 1.5rem;
    transition: color 0.2s ease;
    text-decoration: none;
  }

  .founder-cta:hover {
    color: var(--color-olive);
  }

  .founder-cta svg {
    width: 1rem;
    height: 1rem;
    transition: transform 0.2s ease;
  }

  .founder-cta:hover svg {
    transform: translateX(4px);
  }

  /* Meet Our People heading */
  .meet-people__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.75rem, 1.25rem + 2vw, 2.75rem);
    font-weight: 400;
    color: var(--color-olive);
    text-align: center;
    margin: 0;
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media (min-width: 768px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }
  }

  .team-member {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 640px) {
    .team-member {
      grid-template-columns: 5fr 7fr;
      gap: 2rem;
    }
  }

  .member-portrait .img-placeholder,
  .member-portrait__img {
    aspect-ratio: 4 / 5;
    width: 100%;
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  .member-info {
    order: -1;
  }

  @media (min-width: 640px) {
    .member-info {
      order: 0;
    }
  }

  .member-label {
    font-family: 'Karla', sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-sage);
    margin-bottom: 0.5rem;
  }

  .member-name {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.25rem, 1rem + 1.5vw, 1.5rem);
    font-weight: 500;
    color: var(--color-olive);
    margin-bottom: 0.25rem;
  }

  .member-divider {
    width: 3rem;
    height: 1px;
    background-color: var(--color-gold);
    margin-bottom: 1.25rem;
  }

  .member-text {
    font-size: clamp(0.9375rem, 0.875rem + 0.25vw, 1rem);
    color: var(--color-olive);
    opacity: 0.85;
    line-height: 1.75;
    margin: 0;
  }

  /* Section eyebrow shared style */
  .section-eyebrow {
    font-family: 'Karla', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-gold);
    text-align: center;
    margin-bottom: 0.75rem;
  }

  /* Our Uniqueness Section */
  .uniqueness {
    background-color: var(--color-cream-base);
    padding-top: clamp(2rem, 4vw, 3.5rem);
  }

  .uniqueness__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
    font-weight: 400;
    color: var(--color-olive);
    text-align: center;
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  .uniqueness__lead {
    font-size: clamp(1rem, 0.9375rem + 0.25vw, 1.0625rem);
    color: var(--color-olive);
    opacity: 0.8;
    text-align: center;
    max-width: 48rem;
    margin: 0 auto 3rem;
    line-height: 1.7;
  }

  .uniqueness-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

