---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import TreatmentCard from '../../components/TreatmentCard.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';

// Import all treatment images using Astro's asset system
import abhyangaImg from '../../assets/images/abhyanga.webp';
import udvartanaImg from '../../assets/images/udvartana.webp';
import navarakizhiImg from '../../assets/images/navarakizhi.webp';
import patrapindaImg from '../../assets/images/patrapinda.webp';
import pizhichilImg from '../../assets/images/pizhichil.webp';
import shirodaraImg from '../../assets/images/shirodara.webp';
import netratarpanaImg from '../../assets/images/netratarpana.webp';
import karnapurnaImg from '../../assets/images/karnapurna.webp';
import nasyaImg from '../../assets/images/nasya.webp';
import hrdayaBastiImg from '../../assets/images/hrdaya-basti.webp';
import cakraBastiImg from '../../assets/images/cakra-basti.webp';
import greevaBastiImg from '../../assets/images/greeva-basti.webp';
import katiBastiImg from '../../assets/images/kati-basti.webp';
import januBastiImg from '../../assets/images/janu-basti.webp';
import reflexioImg from '../../assets/images/reflexio.webp';
import svedanaImg from '../../assets/images/svedana.webp';
import takradharaImg from '../../assets/images/takradhara.webp';

// Real clinic photos (October 2026 shoot) replace the earlier generated images
import shirodharaRealImg from '../../assets/images/awh-gallery/awh-10.webp';
import hrdayaBastiRealImg from '../../assets/images/awh-gallery/awh-07.webp';
import cakraBastiRealImg from '../../assets/images/awh-gallery/awh-08.webp';
import javaneseHealingImg from '../../assets/images/awh-gallery/awh-11.webp';
import { Image } from 'astro:assets';

const allTreatments = await getCollection('treatments');

// Image mapping for treatments (using Astro ImageMetadata)
const treatmentImages: Record<string, ImageMetadata> = {
  'Abhyanga': abhyangaImg,
  'Udvartana': udvartanaImg,
  'Navarakizhi': navarakizhiImg,
  'Patra Pinda Sveda': patrapindaImg,
  'Pizhichil': pizhichilImg,
  'Shirodhara': shirodharaRealImg,

  'Netra Tarpana': netratarpanaImg,
  'Karna Purana': karnapurnaImg,
  'Nasya': nasyaImg,
  'Hrdaya Basti': hrdayaBastiRealImg,
  'Cakra Basti': cakraBastiRealImg,
  'Greeva Basti': greevaBastiImg,
  'Kati Basti': katiBastiImg,
  'Janu Basti': januBastiImg,
  'Reflexology': reflexioImg,
  'Svedana': svedanaImg,
  'Ayurvedic Wisdom combined with Javanese energy healing therapy': javaneseHealingImg,
  'Takradhara': takradharaImg,
};

// Separate signature treatments (special) from others
const signatureTreatments = allTreatments.filter(t => t.data.category === 'signature');
const regularTreatments = allTreatments.filter(t => t.data.category !== 'signature' && t.data.category !== 'hidden');

// Sort regular treatments alphabetically by name
regularTreatments.sort((a, b) => a.data.name.localeCompare(b.data.name));

// Collect all image URLs for prefetching
const allImageUrls = Object.values(treatmentImages).map(img => img.src);
---

<BaseLayout
  title="Ayurvedic Massage & Therapy in Bali"
  description="Discover authentic Ayurvedic massage and therapy in Bali, including Abhyanga, Shirodhara, Basti, and personalized consultations at Ayurvedic Wellness House."
  prefetchImages={allImageUrls}
>
  <Navbar />

  <main id="main-content">

    <!-- Page Hero -->
    <PageHero
      eyebrow="Our THerapy"
      title="Ayurvedic Massage &amp; Therapy in Bali"
      subtitle="Every therapy is built on classical Ayurvedic principles and adapted to your specific needs. A consultation is required before your first session."
      image="/images/abhyanga.webp"
      imageAlt="Quiet meditation space at Bali Silent Retreat"
      height="68vh"
      bottomColor="#FAF6F0"
    />

    <!-- Our Treatments Intro Section -->
    <section class="our-treatments-intro section" id="our-treatments">
      <div class="container">
        <div class="our-treatments-intro__inner">
          <h2 class="our-treatments-intro__title">Our Treatments</h2>
          <p class="our-treatments-intro__text">
            Every therapy is built on classical Ayurvedic principles and adapted to your specific needs. A consultation is required before your first session.
          </p>
        </div>
      </div>
    </section>

    <!-- All Regular Treatments -->
    <section class="all-treatments section">
      <div class="container">
        <div class="treatments-grid">
          {regularTreatments.map((treatment, i) => (
            <TreatmentCard
              name={treatment.data.name}
              sanskritName={treatment.data.sanskritName}
              description={treatment.data.description}
              image={treatmentImages[treatment.data.name]}
              category={treatment.data.category}
              icon={treatment.data.icon}
              featured={false}
              link="/book"
              index={i}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="therapy-cta section">
      <div class="container">
        <div class="cta-inner">
          <h2 class="cta-title">Begin with a Consultation</h2>
          <p class="cta-text">
            Every treatment plan starts here. We'll assess your constitution, discuss your health goals, and recommend a program tailored to you.
          </p>
          <div class="cta-actions">
            <a href="/book" class="btn btn-primary">Book now</a>
            <a href="https://wa.me/6285926461359?text=Hello%2C%20I%20would%20like%20to%20book%20a%20consultation%20with%20Dr.%20Komang." target="_blank" rel="noopener noreferrer" class="btn btn-outline">Start Consultation</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <FloatingWhatsApp />
</BaseLayout>

<style>
  .page-header {
    background-color: var(--color-cream-base);
    padding-top: clamp(6rem, 12vw, 10rem);
    padding-bottom: clamp(1rem, 2vw, 2.5rem);
    text-align: center;
  }

  .all-treatments.section {
    padding-top: clamp(1.5rem, 3vw, 3rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .therapy-cta.section {
    padding-top: clamp(2rem, 4vw, 3.5rem);
  }

  /* Our Treatments Intro Section */
  .our-treatments-intro.section {
    background: var(--color-cream-base);
    padding-top: clamp(2rem, 4vw, 4rem);
    padding-bottom: clamp(2rem, 4vw, 4rem);
  }

  .our-treatments-intro__inner {
    max-width: 48rem;
    margin: 0 auto;
    text-align: center;
  }

  .our-treatments-intro__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.75rem, 1.25rem + 2.5vw, 2.75rem);
    font-weight: 400;
    color: var(--color-olive);
    margin-bottom: 1.25rem;
  }

  .our-treatments-intro__text {
    font-size: clamp(1rem, 0.9375rem + 0.25vw, 1.125rem);
    color: var(--color-olive);
    opacity: 0.8;
    line-height: 1.75;
    max-width: 44ch;
    margin: 0 auto;
  }

  .page-eyebrow {
    font-family: 'Karla', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }

  .page-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(2rem, 1.25rem + 3vw, 3.5rem);
    font-weight: 400;
    color: var(--color-olive);
    margin-bottom: 1.5rem;
  }

  .page-description {
    font-size: clamp(1rem, 0.9375rem + 0.25vw, 1.125rem);
    color: var(--color-olive);
    opacity: 0.75;
    max-width: 44ch;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Special Signature Section */
  .special-treatments {
    background: linear-gradient(
      to bottom,
      var(--color-cream-base) 0%,
      var(--color-cream-deep) 100%
    );
  }

  .special-section-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.25rem);
    font-weight: 500;
    color: var(--color-olive);
    text-align: center;
    margin-bottom: 2rem;
    letter-spacing: 0.02em;
  }

  /* Wide signature card: two clinic photos on the left, text on the right */
  .signature-card {
    display: grid;
    max-width: 1180px;
    margin: 0 auto;
    background: var(--color-cream-base);
    border: 2px solid var(--color-gold);
    box-shadow: 0 18px 50px rgba(63, 74, 50, 0.12);
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .signature-card {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }

  .signature-card__photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    min-height: 360px;
    background: var(--color-cream-deep);
  }

  .signature-card__photos :global(.signature-card__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .signature-card__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.75rem, 4vw, 3.25rem);
  }

  .signature-card__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.75rem, 1.25rem + 1.6vw, 2.6rem);
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-olive);
    margin: 0 0 0.5rem;
  }

  .signature-card__sanskrit {
    font-family: 'Fraunces', Georgia, serif;
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-sage);
    margin: 0 0 1.25rem;
  }

  .signature-card__text {
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    font-weight: 500;
    line-height: 1.75;
    color: var(--color-olive);
    opacity: 0.9;
    margin: 0 0 1.5rem;
  }

  .signature-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-sage-dark);
    text-decoration: none;
  }

  .signature-card__link:hover {
    color: var(--color-olive);
  }

  .signature-card__link svg {
    width: 1rem;
    height: 1rem;
  }

  /* Treatments Grid */
  .treatments-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 640px) {
    .treatments-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .treatments-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* CTA */
  .cta-inner {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto;
  }

  .cta-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
    font-weight: 400;
    color: var(--color-olive);
    margin-bottom: 1rem;
  }

  .cta-text {
    font-size: clamp(1rem, 0.9375rem + 0.25vw, 1.0625rem);
    color: var(--color-olive);
    opacity: 0.8;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    font-family: 'Karla', sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    border-radius: 0.125rem;
    border: 2px solid var(--color-sage);
    background-color: transparent;
    color: var(--color-olive);
    cursor: pointer;
    transition: all 0.25s ease;
    text-decoration: none;
  }

  .btn-outline:hover {
    background-color: var(--color-sage);
    color: white;
  }
</style>
