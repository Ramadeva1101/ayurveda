---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import SectionDivider from '../components/SectionDivider.astro';
import PageHero from '../components/PageHero.astro';

// Approx conversion rates (indicative only, updated periodically)
// 1 USD ≈ 16,400 IDR | 1 AUD ≈ 10,600 IDR | 1 EUR ≈ 17,800 IDR
function idrToApprox(idrAmount: number) {
  const usd = Math.ceil(idrAmount / 16400 / 5) * 5;   // round up to nearest $5
  const aud = Math.ceil(idrAmount / 10600 / 5) * 5;   // round up to nearest A$5
  const eur = Math.ceil(idrAmount / 17800 / 5) * 5;   // round up to nearest €5
  return `≈ USD ${usd.toLocaleString()} / AUD ${aud.toLocaleString()} / EUR ${eur.toLocaleString()}`;
}

const bsrUrl = 'https://www.balisilentretreat.com/';
const externalLink = (label: string) => `<a href="${bsrUrl}" target="_blank" rel="noopener noreferrer">${label}</a>`;
const linkBsr = (text: string) => text
  .replaceAll(bsrUrl, '__BSR_URL__')
  .replaceAll('Bali Silent Retreat', externalLink('Bali Silent Retreat'))
  .replaceAll('__BSR_URL__', externalLink('Bali Silent Retreat website'));

// Matches the service slugs in Admin > Services, so /book opens with it selected
const slugify = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const packages = [
  {
    name: 'Ayurvedic Javanese Healing Experience',
    duration: '1 hr – 1.5 hr',
    price: 'IDR 1,500,000++',
    amount: 1500000,
    approxRates: idrToApprox(1500000),
    highlight: 'Experience authentic Energy Healing of Javanese Point Pressure explained live by an Ayurvedic expert.',
    note: 'Meals is offered on a donation basis (minimum of 50K). We warmly invite you to make your contribution at the Bali Silent Retreat Reception as an expression of gratitude.',
    includes: [],
    badge: null,
    featured: false,
  },
  {
    name: '3-Day Ayurvedic & Javanese Energy Healing Experience',
    duration: 'accommodation and day pass NOT included ; make booking directly @ https://www.balisilentretreat.com/',
    durationLine2: '(different rooms different prices)',
    price: 'IDR 5,900,000++',
    amount: 5900000,
    approxRates: idrToApprox(5900000),
    highlight: 'Perfect introduction to Ayurvedic healing.',
    includes: [
      'Nutritional drink',
      'Initial Comprehensive Ayurvedic One on One',
      '2-times Personalized Ayurvedic Therapy',
      'Javanese point pressure therapy',
      'Final Ayurvedic One on One',
    ],
    badge: null,
    featured: false,
  },
  {
    name: '7-Day Ayurvedic Pancha Karma & Javanese Energy Healing Experience',
    duration: 'accommodation and day pass NOT included ; make booking directly @ https://www.balisilentretreat.com/',
    durationLine2: '(different rooms different prices)',
    price: 'IDR 15,000,000++',
    amount: 15000000,
    approxRates: idrToApprox(15000000),
    highlight: 'Our most popular program.',
    includes: [
      'Nutritional drink',
      'Initial Comprehensive Ayurvedic One on One',
      '5-times Personalized Ayurvedic Therapy',
      'One recommended Panchakarma therapy',
      '2 times-Javanese point pressure therapy',
      'Final Ayurvedic One on One',
    ],
    badge: 'Most Popular',
    featured: true,
  },
  {
    name: '14-Day Ayurvedic Deep Pancha Karma & Javanese Energy Healing Experience',
    duration: 'accommodation and day pass NOT included ; make booking directly @ https://www.balisilentretreat.com/',
    durationLine2: '(different rooms different prices)',
    price: 'IDR 29,000,000++',
    amount: 29000000,
    approxRates: idrToApprox(29000000),
    highlight: 'Premium physician-led Pancha Karma and rejuvenation.',
    includes: [
      'Nutritional drink',
      'Initial Comprehensive Ayurvedic One on One',
      '10-times Personalized Ayurvedic Therapy',
      'Two recommended Panchakarma therapy',
      '4 times-Javanese point pressure therapy',
      'Final Ayurvedic One on One',
    ],
    badge: null,
    featured: false,
  },
  {
    name: '21-Day Complete Ayurvedic Deep Pancha Karma & Javanese Energy Healing Experience',
    duration: 'accommodation and day pass NOT included ; make booking directly @ https://www.balisilentretreat.com/',
    durationLine2: '(different rooms different prices)',
    price: 'IDR 43,000,000++',
    amount: 43000000,
    approxRates: idrToApprox(43000000),
    highlight: 'Our most comprehensive program.',
    includes: [
      'Nutritional drink',
      'Initial Comprehensive Ayurvedic One on One',
      '15-times Personalized Ayurvedic Therapy',
      'Two or three recommended Panchakarma therapy (depend on physical condition)',
      '6 times-Javanese point pressure therapy',
      'Final Ayurvedic One on One',
    ],
    badge: null,
    featured: false,
  },
];
---

<BaseLayout
  title="Our Wellness Programs"
  description="Treatment programs at Ayurvedic Wellness House — from personalized healing sessions to 3, 7, 14, and 21-day classical Panchakarma programs, all built on classical Ayurvedic and Javanese healing principles."
>
  <Navbar />

  <main id="main-content">

    <!-- Page Hero -->
    <PageHero
      eyebrow="Ayurvedic rejuvenation & panchakarma programs"
      title="Our Wellness&nbsp;Programs"
      subtitle="Each program is designed around a specific wellness goal — from a single day to 21 days of deep classical Pancha Karma."
      image="/images/spectacular view of batukaru_11zon.webp"
      imageAlt="Spectacular view of Mount Batukaru and green rice fields"
      height="68vh"
      bottomColor="#FAF6F0"
    />

    <!-- Package Cards -->
    <section class="packages section">
      <div class="container">
        <div class="packages-grid">

          {packages.map((pkg) => (
            <article class:list={['package-card', { 'package-card--featured': pkg.featured }]}>
              {pkg.badge && (
                <div class="package-badge">{pkg.badge}</div>
              )}
              <div class="package-header">
                <h2 class="package-name">{pkg.name}</h2>
              </div>
              <div class="package-duration">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>
                  <span set:html={linkBsr(pkg.duration)} />
                  {pkg.durationLine2 && <span class="duration-line2">{pkg.durationLine2}</span>}
                </span>
              </div>
              <div class="package-price">
                <span class="price-regular">
                  <span class="price-amount">{pkg.price}</span>
                  <span class="price-approx">{pkg.approxRates}</span>
                </span>
                <span class="price-offer" data-amount={pkg.amount}>
                  <span class="offer-tag"></span>
                  <s class="price-was">{pkg.price}</s>
                  <span class="price-amount"></span>
                  <span class="price-approx"></span>
                </span>
                <span class="price-note">++ tax &amp; service charge</span>
              </div>
              <div class="package-highlight">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                <span>{pkg.highlight}</span>
              </div>
              {pkg.note && (
                <p class="package-note" set:html={linkBsr(pkg.note)} />
              )}
              {pkg.includes && pkg.includes.length > 0 && (
                <div class="package-includes">
                  <p class="includes-label">Includes</p>
                  <ul class="includes-list">
                    {pkg.includes.map((item) => (
                      <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {pkg.excludes && pkg.excludes.length > 0 && (
                <div class="package-excludes">
                  <p class="excludes-label">Excludes</p>
                  <ul class="excludes-list">
                    {pkg.excludes.map((item) => (
                      <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <line x1="18" y1="6" x2="6" y2="18"></line>
                          <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              <a href={`/book?service=${slugify(pkg.name)}`} class:list={['package-btn', { 'btn': true, 'btn-primary': pkg.featured, 'btn-outline': !pkg.featured }]}>Book Now</a>
            </article>
          ))}

        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="packages-cta section section--dark">
      <div class="container">
        <div class="cta-inner">
          <h2 class="cta-title">Ready to Begin?</h2>
          <p class="cta-text">
            Program clarification? We can help determine the best program for your needs and goals.
          </p>
          <div class="cta-actions">
            <a href="/contact" class="btn btn-secondary">Contact Us</a>
          </div>
          <p class="cta-partner">
            Need accommodation and transport too? See the <a href="/our-local-partner">wellness packages with our local partner, Nice Tour Bali</a>.
          </p>
        </div>
      </div>
    </section>

  </main>

  <Footer />

  <script is:inline>
    // Package offer comes from Admin > Settings through /api/offer.php, so the
    // clinic can start or stop it without rebuilding the site. If the API is
    // unreachable, normal prices stay on the page.
    (function () {
      // Same rounding as idrToApprox() in the page frontmatter.
      function approx(idr) {
        var up = function (v) { return Math.ceil(v / 5) * 5; };
        return '≈ USD ' + up(idr / 16400).toLocaleString() + ' / AUD ' + up(idr / 10600).toLocaleString() + ' / EUR ' + up(idr / 17800).toLocaleString();
      }
      fetch('/api/offer.php').then(function (r) { return r.json(); }).then(function (o) {
        if (!o || !o.percent) return;
        var month = new Date(o.until + 'T00:00:00').toLocaleDateString('en-GB', { month: 'long' });
        document.querySelectorAll('.price-offer[data-amount]').forEach(function (el) {
          var price = Math.round(Number(el.dataset.amount) * (100 - o.percent) / 100);
          el.querySelector('.offer-tag').textContent = o.percent + '% off until ' + new Date(o.until + 'T00:00:00').getDate() + ' ' + month;
          el.querySelector('.price-amount').textContent = 'IDR ' + price.toLocaleString('en-US') + '++';
          el.querySelector('.price-approx').textContent = approx(price);
        });
        document.documentElement.classList.add('offer-on');
      }).catch(function () {});
    })();
  </script>
  <FloatingWhatsApp />
</BaseLayout>

<style>
  .page-header {
    background-color: var(--color-cream-base);
    padding-top: clamp(6rem, 12vw, 10rem);
    padding-bottom: clamp(1rem, 2vw, 2.5rem);
    text-align: center;
  }

  .packages.section {
    padding-top: clamp(1.5rem, 3vw, 3rem);
  }

  .page-eyebrow {
    font-family: 'Karla', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }

  .page-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(2rem, 1.25rem + 3vw, 3.5rem);
    font-weight: 400;
    color: var(--color-olive);
    margin-bottom: 1.5rem;
  }

  .page-description {
    font-size: clamp(1rem, 0.9375rem + 0.25vw, 1.125rem);
    color: var(--color-olive);
    opacity: 0.75;
    max-width: 50ch;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Packages Grid */
  .packages-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 640px) {
    .packages-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .packages-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Package Card */
  .package-card {
    position: relative;
    background-color: var(--color-cream-base);
    border: 1px solid var(--color-cream-deep);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }

  .package-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(63, 74, 50, 0.08);
  }

  /* Featured card — Gold border */
  .package-card--featured {
    border: 2px solid var(--color-gold);
  }

  .package-card--featured:hover {
    box-shadow: 0 16px 48px rgba(63, 74, 50, 0.12);
  }

  /* Badge */
  .package-badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Karla', sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.875rem;
    border-radius: 9999px;
    background-color: var(--color-gold);
    color: white;
    white-space: nowrap;
  }

  .package-header {
    margin-bottom: 1rem;
  }

  .package-name {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.125rem, 1rem + 1vw, 1.375rem);
    font-weight: 500;
    color: var(--color-olive);
    line-height: 1.3;
  }

  /* Duration */
  .package-duration {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-family: 'Karla', sans-serif;
    font-size: 0.8125rem;
    color: var(--color-sage);
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }

  .package-duration svg {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    color: var(--color-gold);
    margin-top: 0.15rem;
  }

  .package-duration :global(a),
  .package-note :global(a) {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .duration-line2 {
    display: block;
  }

  /* Price */
  /* November offer: hidden unless the script below finds today inside the offer dates */
  .price-regular,
  .price-offer {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .price-offer {
    display: none;
  }

  :global(html.offer-on) .price-offer {
    display: flex;
  }

  :global(html.offer-on) .price-regular {
    display: none;
  }

  .offer-tag {
    align-self: flex-start;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--color-gold);
    color: #fff;
    font-family: 'Karla', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .price-was {
    font-family: 'Karla', sans-serif;
    font-size: 0.9rem;
    color: var(--color-sage);
  }

  .package-price {
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .price-amount {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.25rem, 1rem + 1.5vw, 1.75rem);
    font-weight: 500;
    color: var(--color-olive);
    line-height: 1.2;
  }

  .price-approx {
    font-family: 'Karla', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-gold);
    letter-spacing: 0.01em;
  }

  .price-note {
    font-family: 'Karla', sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--color-sage);
    letter-spacing: 0.02em;
    font-style: italic;
  }

  /* Highlight */
  .package-highlight {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.75rem;
    background-color: rgba(184, 147, 90, 0.08);
    border-left: 2px solid var(--color-gold);
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    font-style: italic;
    color: var(--color-olive);
    line-height: 1.4;
  }

  .package-highlight svg {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    color: var(--color-gold);
    margin-top: 0.125rem;
  }

  .package-highlight span {
    color: var(--color-olive);
  }

  /* Note (e.g. lunch donation note) */
  .package-note {
    font-family: 'Karla', sans-serif;
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-sage);
    line-height: 1.5;
    margin: -0.5rem 0 1.25rem;
    padding: 0.625rem 0.75rem;
    border-left: 2px solid rgba(184, 147, 90, 0.35);
    background: rgba(184, 147, 90, 0.04);
  }

  /* Includes */
  .package-includes {
    margin-bottom: 1.25rem;
  }

  .includes-label,
  .excludes-label {
    font-family: 'Karla', sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-olive);
    opacity: 0.5;
    margin-bottom: 0.625rem;
  }

  .includes-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .includes-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-olive);
    line-height: 1.4;
  }

  .includes-list li svg {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
    margin-top: 0.1875rem;
    color: var(--color-sage);
  }

  /* Excludes */
  .package-excludes {
    margin-bottom: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-cream-deep);
  }

  .excludes-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .excludes-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-sage);
    opacity: 0.75;
    line-height: 1.4;
  }

  .excludes-list li svg {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
    margin-top: 0.1875rem;
    opacity: 0.6;
  }

  /* Buttons */
  .package-btn {
    width: 100%;
    justify-content: center;
    text-decoration: none;
  }

  /* CTA Section */
  .packages-cta {
    text-align: center;
  }

  .cta-inner {
    max-width: 40rem;
    margin: 0 auto;
  }

  .cta-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
    font-weight: 400;
    font-style: italic;
    color: var(--color-cream-base);
    margin-bottom: 1rem;
  }

  .cta-text {
    font-size: clamp(1rem, 0.9375rem + 0.25vw, 1.0625rem);
    color: var(--color-cream-base);
    opacity: 0.85;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .cta-partner {
    font-size: 0.9375rem;
    color: var(--color-cream-base);
    opacity: 0.85;
    line-height: 1.6;
    margin: 2rem 0 0;
  }

  .cta-partner a {
    color: var(--color-gold-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cta-partner a:hover {
    color: var(--color-cream-base);
  }

  .btn-outline-white {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    font-family: 'Karla', sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    border-radius: 0.125rem;
    border: 2px solid var(--color-cream-base);
    background-color: transparent;
    color: var(--color-cream-base);
    cursor: pointer;
    transition: all 0.25s ease;
    text-decoration: none;
  }

  .btn-outline-white:hover {
    background-color: var(--color-cream-base);
    color: var(--color-olive);
  }

  @media (max-width: 640px) {
    .package-card {
      padding: 1.5rem;
    }
  }
</style>
