---
import { Image } from 'astro:assets';
import logoImg from '../assets/images/logo.png';

import { navItems, serviceMenu, waLink } from '../data/menu';

// Selected guest videos shown above the footer on every page (the separate
// Testimonials page was removed). Names come from each video's YouTube title.
const youtubeChannel = 'https://www.youtube.com/@ayurvedicwellnesshouse';
const guestVideos = [
  { youtubeId: 'KW4Q5kK0TGU', name: 'Nisha' },
  { youtubeId: 'Jga5WdFywzI', name: 'Dr. Balvinder' },
  { youtubeId: '9Yc_3wSAe7I', name: 'Ms. Samantha' },
];
const mapsUrl = 'https://maps.app.goo.gl/gRzEuCPrURoJJ8rG8';
const waConsult = waLink('Hello, I would like to book a consultation with Dr. Komang.');

const currentYear = new Date().getFullYear();
---

<!-- Guest videos (shown on every page) -->
<section class="guest-videos" id="guest-videos" aria-labelledby="guest-videos-title">
  <div class="container">
    <p class="gv-eyebrow">Testimonials</p>
    <h2 class="gv-title" id="guest-videos-title">Hear from our guests</h2>
    <div class="gv-grid">
      {guestVideos.map((v) => (
        <button type="button" class="gv-card" data-video-id={v.youtubeId} aria-label={`Play video: ${v.name}`}>
          <img src={`https://img.youtube.com/vi/${v.youtubeId}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
          <span class="gv-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg></span>
          <span class="gv-name">{v.name}</span>
        </button>
      ))}
    </div>
    <p class="gv-more"><a href={youtubeChannel} target="_blank" rel="noopener noreferrer">More videos on YouTube</a></p>
  </div>
</section>

<!-- Contact (shown on every page) -->
<section class="contact-band" id="contact" aria-labelledby="contact-band-title">
  <div class="container contact-band__inner">
    <div>
      <p class="gv-eyebrow">Contact</p>
      <h2 class="contact-band__title" id="contact-band-title">Get in Touch</h2>
      <p class="contact-band__text">Ayurvedic Wellness House, Tabanan, Bali, Indonesia.</p>
    </div>
    <div class="contact-band__actions">
      <a href={waConsult} target="_blank" rel="noopener noreferrer" class="cb-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.5A8.4 8.4 0 1 1 21 11.5z"></path></svg>
        <span><b>WhatsApp</b>+62 859-2646-1359</span>
      </a>
      <a href="mailto:booking@ayurvedicwellnesshouse.com" class="cb-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        <span><b>Email</b>booking@ayurvedicwellnesshouse.com</span>
      </a>
      <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="cb-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        <span><b>Location</b>View on Google Maps</span>
      </a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Ayurvedic Wellness House">
          <Image
            src={logoImg}
            alt="Ayurvedic Wellness House"
            class="footer-logo-img"
            width={600}
          />
        </a>
        <p class="footer-tagline">Authentic Ayurvedic Wisdom and therapy combining with Javanese energy healing therapy</p>
        <!-- Social Links -->
        <div class="footer-social">
          <a href="https://instagram.com/Ayurvedicwellnesshouse" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer-links">
        <h4 class="footer-heading">Navigate</h4>
        <ul class="footer-menu">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class="footer-link">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div class="footer-services">
        <h4 class="footer-heading">Our Service</h4>
        <ul class="footer-menu">
          {serviceMenu.map((item) => (
            <li><a href={item.href} class="footer-link">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="footer-contact">
        <h4 class="footer-heading">Get in Touch</h4>
        <address class="footer-address">
          <p class="footer-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>
              Ayurvedic Wellness House, Tabanan, Bali, Indonesia.<br />
              <a href="https://maps.app.goo.gl/gRzEuCPrURoJJ8rG8" target="_blank" rel="noopener noreferrer" class="footer-location-link">View on Google Maps</a>
            </span>
          </p>

          <a href="https://wa.me/6285926461359" target="_blank" rel="noopener noreferrer" class="footer-contact-item footer-contact-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>+62 859-2646-1359</span>
          </a>

          <a href="mailto:booking@ayurvedicwellnesshouse.com" class="footer-contact-item footer-contact-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>booking@ayurvedicwellnesshouse.com</span>
          </a>

          <a href="https://instagram.com/Ayurvedicwellnesshouse" target="_blank" rel="noopener noreferrer" class="footer-contact-item footer-contact-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            <span>@Ayurvedicwellnesshouse</span>
          </a>
        </address>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="footer-divider"></div>
      <p class="footer-copyright">
        &copy; {currentYear} Ayurvedic Wellness House. All rights reserved.
      </p>
      <p class="footer-credit">
        Led by <strong>Dr. Komang Sudarmi, BAMS., MS., PhD (Ayurveda)</strong>
      </p>
    </div>
  </div>
</footer>

<script>
  // Load the YouTube player only when a guest video is clicked.
  document.querySelectorAll<HTMLButtonElement>('.gv-card').forEach((btn) => {
    btn.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.videoId}?autoplay=1`;
      frame.title = btn.getAttribute('aria-label') || 'Guest video';
      frame.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      frame.className = 'gv-frame';
      btn.replaceWith(frame);
    });
  });
</script>

<style>
  .guest-videos {
    padding: 5rem 0;
    background: var(--color-cream-base);
    text-align: center;
  }

  .gv-eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-dark);
  }

  .gv-title,
  .contact-band__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.9rem, 1.4rem + 1.8vw, 2.8rem);
    font-weight: 500;
    color: var(--color-olive);
    margin: 0 0 2.25rem;
  }

  .gv-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .gv-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gv-card,
  :global(.gv-frame) {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: #000;
    cursor: pointer;
  }

  .gv-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.2s ease, transform 0.3s ease;
  }

  .gv-card:hover img {
    opacity: 1;
    transform: scale(1.03);
  }

  .gv-play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: var(--color-gold);
    color: #fff;
    transform: translate(-50%, -50%);
  }

  .gv-name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.5rem 1rem 0.75rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
    color: #fff;
    font-weight: 700;
    text-align: left;
  }

  .gv-more {
    margin: 1.75rem 0 0;
  }

  .gv-more a {
    font-weight: 700;
    color: var(--color-olive);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .contact-band {
    padding: 4rem 0;
    background: #fff;
    border-top: 1px solid var(--color-cream-deep);
  }

  .contact-band__inner {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .contact-band__inner {
      grid-template-columns: 1fr 2.6fr;
    }
  }

  .contact-band__title {
    margin-bottom: 0.5rem;
  }

  .contact-band__text {
    margin: 0;
    font-weight: 500;
    color: var(--color-sage);
  }

  .contact-band__actions {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .contact-band__actions {
      grid-template-columns: 1fr 1.6fr 1fr;
    }
  }

  .cb-link {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--color-cream-deep);
    color: var(--color-olive);
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .cb-link:hover {
    border-color: var(--color-gold);
    background: var(--color-cream-base);
  }

  .cb-link svg {
    flex-shrink: 0;
    width: 1.6rem;
    height: 1.6rem;
    color: var(--color-gold);
  }

  .cb-link span {
    display: flex;
    flex-direction: column;
    min-width: 0;
    font-size: 0.9rem;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .cb-link b {
    font-size: 1rem;
  }

  .footer {
    background-color: var(--color-cream-deep);
    padding-top: 4rem;
    /* iPhone home indicator safe area */
    padding-bottom: max(2rem, env(safe-area-inset-bottom) + 1rem);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1.5fr;
    }
  }

  .footer-brand {
    margin-bottom: 1rem;
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: 1rem;
  }

  .footer-logo-img {
    height: 3.5rem;
    width: auto;
  }

  .footer-tagline {
    font-size: 0.9375rem;
    color: var(--color-sage);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .footer-social {
    display: flex;
    gap: 1rem;
  }

  .footer-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-sage);
    border-radius: 50%;
    color: var(--color-olive);
    transition: all 0.2s ease;
  }

  .footer-social a:hover {
    background-color: var(--color-olive);
    border-color: var(--color-olive);
    color: white;
  }

  .footer-social svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .footer-heading {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-olive);
    margin-bottom: 1.5rem;
  }

  .footer-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-link {
    font-size: 0.9375rem;
    color: var(--color-sage);
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--color-olive);
  }

  .footer-address {
    font-style: normal;
  }

  .footer-contact-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--color-sage);
    margin-bottom: 1rem;
  }

  .footer-contact-link {
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-contact-link:hover {
    color: var(--color-olive);
  }

  .footer-contact-item svg {
    flex-shrink: 0;
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.125rem;
    color: var(--color-gold);
  }

  .footer-location-link {
    display: inline-block;
    margin-top: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .footer-location-link:hover {
    color: var(--color-olive);
  }

  .footer-bottom {
    margin-top: 3rem;
    padding-top: 2rem;
    text-align: center;
  }

  .footer-divider {
    height: 1px;
    background-color: var(--color-gold);
    opacity: 0.3;
    margin-bottom: 1.5rem;
  }

  .footer-copyright {
    font-size: 0.8125rem;
    color: var(--color-sage);
    margin-bottom: 0.5rem;
  }

  .footer-credit {
    font-size: 0.8125rem;
    color: var(--color-olive);
  }

  .footer-credit strong {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
  }
</style>
