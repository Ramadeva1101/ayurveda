---
// Line icons for the Our Service and Wellness Package menus.
interface Props { name: string; size?: number }
const { name, size = 40 } = Astro.props;

// Our Service icons supplied by the client (public/icons). Used as a mask so
// they take the text colour (gold, white on hover) like the line icons below.
const clientIcons: Record<string, string> = {
  consultation: '/icons/lotus.png',
  energy: '/icons/meditation.png',
  therapy: '/icons/herbs.png',
  water: '/icons/hands-drop.png',
};
const img = clientIcons[name];
---
{img ? (
  <span
    class="menu-icon-img"
    aria-hidden="true"
    style={`display:inline-block;width:${size * 1.15}px;height:${size * 1.15}px;background-color:currentColor;-webkit-mask:url('${img}') center / contain no-repeat;mask:url('${img}') center / contain no-repeat;`}
  ></span>
) : (
<svg width={size} height={size} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'consultation' && (<>
    <circle cx="17" cy="15" r="5" /><path d="M8 34c0-5.5 4-9 9-9s9 3.5 9 9" />
    <path d="M27 10h14v10h-6l-4 4v-4h-4z" /><path d="M31 14h6M31 17h4" />
    <path d="M6 38h36" />
  </>)}
  {name === 'energy' && (<>
    <circle cx="24" cy="10" r="4" /><path d="M24 15v13M16 21l8 4 8-4M18 40l6-12 6 12" />
    <path d="M9 12a18 18 0 0 0-2 9M39 12a18 18 0 0 1 2 9M12 7a20 20 0 0 0-3 3M36 7a20 20 0 0 1 3 3" />
  </>)}
  {name === 'therapy' && (<>
    <path d="M14 22a10 6 0 0 0 20 0z" /><path d="M24 22V12" /><path d="M24 12c3-4 8-4 10-3-1 4-5 6-10 3z" />
    <path d="M24 12c-3-4-8-4-10-3 1 4 5 6 10 3z" /><path d="M10 32c4 3 24 3 28 0" /><path d="M16 38h16" />
  </>)}
  {name === 'water' && (<>
    <path d="M24 6c6 8 10 13 10 19a10 10 0 0 1-20 0c0-6 4-11 10-19z" /><path d="M19 26a5 5 0 0 0 5 5" />
    <path d="M8 40c3-2 5-2 8 0s5 2 8 0 5-2 8 0 5 2 8 0" />
  </>)}
  {name === 'detox' && (<>
    <path d="M10 24h28a14 12 0 0 1-28 0z" /><path d="M16 40h16M24 36v4" />
    <path d="M30 22l8-14" /><path d="M20 20c-2-5 0-10 4-12 1 5-1 9-4 12zM26 20c3-3 7-3 9-2-2 3-5 4-9 2z" />
  </>)}
  {name === 'rejuvenation' && (<>
    <circle cx="24" cy="24" r="6" /><path d="M24 6v6M24 36v6M6 24h6M36 24h6M11 11l4 4M33 33l4 4M37 11l-4 4M15 33l-4 4" />
  </>)}
  {name === 'weight' && (<>
    <path d="M14 8c0 8 3 10 3 16s-3 8-3 16M34 8c0 8-3 10-3 16s3 8 3 16" />
    <path d="M6 24h7M8 21l3 3-3 3M42 24h-7M40 21l-3 3 3 3" />
  </>)}
  {name === 'joints' && (<>
    <path d="M18 6v14l-3 4M30 42V28l3-4" /><circle cx="24" cy="24" r="6" />
    <path d="M12 10l4 4M36 38l-4-4M10 22h3M35 26h3" />
  </>)}
  {name === 'stress' && (<>
    <circle cx="24" cy="11" r="4" /><path d="M24 16v9" /><path d="M14 31c3-4 6-6 10-6s7 2 10 6" />
    <path d="M10 36h28" /><path d="M17 21l-6 4M31 21l6 4" />
  </>)}
</svg>
)}
