---
import { Image } from 'astro:assets';
import logoImg from '../assets/images/logo.png';
import logoHomeImg from '../assets/images/logo-home.png';

import MenuIcon from './MenuIcon.astro';
import { navItems } from '../data/menu';

const currentPath = Astro.url.pathname;
const bookActive = currentPath.startsWith('/book');
const isHome = currentPath === '/';
const isActive = (item: { href: string; children?: { href: string }[] }) =>
  currentPath === item.href ||
  (item.href !== '/' && currentPath.startsWith(item.href)) ||
  !!item.children?.some((c) => currentPath === c.href.split('#')[0]);
---

<header id="navbar" class:list={['navbar', { 'navbar--home': isHome }]}>
  <div class="navbar-container">
    <div class="container">
      <div class="navbar-inner">
        <!-- Logo -->
        <a href="/" class="navbar-logo" aria-label="Ayurvedic Wellness House - Home">
          <Image
            id="navbar-logo-img"
            src={isHome ? logoHomeImg : logoImg}
            alt="Ayurvedic Wellness House"
            class="navbar-logo-img"
            width={600}
            loading="eager"
            data-logo-src={logoImg.src}
            data-logo-home-src={logoHomeImg.src}
          />
        </a>

        <!-- Desktop Navigation -->
        <nav class="navbar-nav" aria-label="Main navigation">
          <ul class="navbar-menu">
            {navItems.map((item) => (
              <li class:list={[{ 'has-drop': item.children }]}>
                <a href={item.href} class:list={['navbar-link', { active: isActive(item) }]} aria-haspopup={item.children ? 'true' : undefined}>
                  {item.label}
                  {item.children && (
                    <svg class="navbar-caret" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  )}
                </a>
                {item.children && (
                  <div class="drop">
                    <ul class="drop__list">
                      {item.children.map((c) => (
                        <li>
                          <a href={c.href} class="drop__item">
                            <span class="drop__icon"><MenuIcon name={c.icon} /></span>
                            <span class="drop__label">{c.label}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            ))}
          </ul>
          <a href="/book" class:list={['navbar-book', { active: bookActive }]}>Book now</a>
        </nav>

        <!-- Mobile Menu Button -->
        <button
          type="button"
          id="mobile-menu-toggle"
          class="navbar-toggle"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Open menu"
        >
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile navigation">
      <div class="container">
        <ul class="mobile-nav-list">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class:list={['mobile-nav-link', { active: isActive(item) }]}>{item.label}</a>
              {item.children && (
                <ul class="mobile-sub">
                  {item.children.map((c) => (
                    <li><a href={c.href} class="mobile-sub-link"><MenuIcon name={c.icon} size={26} />{c.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
        <a href="/book" class="mobile-book">Book now</a>
      </div>
    </nav>
  </div>
</header>

<script>
  function initNavbar() {
    const navbar = document.getElementById('navbar');
    const logoImgEl = document.getElementById('navbar-logo-img') as HTMLImageElement | null;
    const toggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');

    if (!navbar || !toggle || !mobileMenu) return;

    const isHomePage = navbar.classList.contains('navbar--home');
    let isMenuOpen = false;

    const logoSrc = logoImgEl ? (logoImgEl as any).dataset.logoSrc : undefined;
    const logoHomeSrc = logoImgEl ? (logoImgEl as any).dataset.logoHomeSrc : undefined;

    function handleScroll() {
      if (isHomePage && logoImgEl) {
        if (window.scrollY > 50) {
          navbar.classList.add('scrolled');
          if (logoSrc) {
            logoImgEl.src = logoSrc;
          }
        } else {
          navbar.classList.remove('scrolled');
          if (logoHomeSrc) {
            logoImgEl.src = logoHomeSrc;
          }
        }
      }
    }

    function toggleMenu() {
      isMenuOpen = !isMenuOpen;
      toggle.classList.toggle('is-open', isMenuOpen);
      toggle.setAttribute('aria-expanded', String(isMenuOpen));
      mobileMenu.classList.toggle('is-open', isMenuOpen);
      document.body.classList.toggle('menu-open', isMenuOpen);
    }

    function closeMenu() {
      isMenuOpen = false;
      toggle.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      mobileMenu.classList.remove('is-open');
      document.body.classList.remove('menu-open');
    }

    toggle.addEventListener('click', toggleMenu);
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isMenuOpen) closeMenu();
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024 && isMenuOpen) closeMenu();
    });
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  document.addEventListener('DOMContentLoaded', initNavbar);
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    transition: background-color 0.3s ease, box-shadow 0.3s ease, padding 0.3s ease;
  }

  .navbar--home:not(.scrolled) {
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .navbar--home:not(.scrolled)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: calc(100% + 64px);
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(16, 24, 13, 0.55) 0%,
      rgba(16, 24, 13, 0.4) 35%,
      rgba(16, 24, 13, 0.15) 70%,
      rgba(16, 24, 13, 0) 100%
    );
  }

  .navbar--home:not(.scrolled) .navbar-logo-img {
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.55));
  }

  .navbar.scrolled,
  .navbar:not(.navbar--home) {
    background-color: rgba(250, 246, 240, 0.97);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 2px 16px rgba(63, 74, 50, 0.1);
  }

  .navbar-container {
    width: 100%;
  }

  /* Wider than the page container so the logo sits further left and the menu further right */
  .navbar-container > .container {
    max-width: 1480px;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    min-height: 5rem;
    transition: padding 0.3s ease;
    /* iPhone notch: pad the sides of the inner bar */
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
  }

  .navbar.scrolled .navbar-inner,
  .navbar:not(.navbar--home) .navbar-inner {
    padding: 0.625rem 0;
  }

  .navbar-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .navbar-logo-img {
    height: 2.5rem;
    width: auto;
    transition: height 0.3s ease;
  }

  .navbar.scrolled .navbar-logo-img,
  .navbar:not(.navbar--home) .navbar-logo-img {
    height: 2.25rem;
  }

  .navbar-nav {
    display: none;
    visibility: hidden;
    opacity: 0;
  }

  /* Desktop: show nav, hide mobile toggle */
  @media (min-width: 1200px) {
    .navbar-nav {
      display: flex;
      align-items: center;
      margin-left: 2rem;
      visibility: visible;
      opacity: 1;
    }
  }

  .navbar-menu {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }

  /* 7 menu items: tighten spacing on small desktops so they fit on one line */
  @media (min-width: 1200px) and (max-width: 1365px) {
    .navbar-menu {
      gap: 0.7rem;
    }

    .navbar-nav {
      margin-left: 1.25rem;
    }

    .navbar-nav .navbar-book {
      margin-left: 0.8rem;
      padding: 0.5rem 0.85rem;
      font-size: 0.6875rem;
    }
  }

  .navbar-link {
    position: relative;
    font-family: 'Karla', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(250, 246, 240, 0.85);
    padding: 0.375rem 0;
    transition: color 0.2s ease;
    text-decoration: none;
  }

  @media (min-width: 1200px) and (max-width: 1365px) {
    .navbar-link {
      font-size: 0.65rem;
      letter-spacing: 0.01em;
    }
  }

  .navbar--home:not(.scrolled) .navbar-link {
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9), 0 2px 8px rgba(0, 0, 0, 0.45);
  }

  .navbar-book {
    margin-left: 1.25rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    background: var(--color-gold);
    color: #fff;
    font-family: 'Karla', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(154, 120, 69, 0.35);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .navbar-book:hover {
    background: var(--color-gold-dark);
    transform: translateY(-1px);
  }

  .navbar-book.active {
    background: var(--color-olive);
    box-shadow: none;
  }

  .mobile-book {
    display: block;
    margin: 1rem 0 0.5rem;
    padding: 0.9rem 1rem;
    border-radius: 999px;
    background: var(--color-gold);
    color: #fff;
    text-align: center;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .navbar-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-gold);
    transition: width 0.3s ease;
  }

  .navbar-link:hover::after,
  .navbar-link.active::after {
    width: 100%;
  }

  .navbar-link:hover,
  .navbar-link.active {
    color: var(--color-cream-base);
  }

  .navbar.scrolled .navbar-link,
  .navbar:not(.navbar--home) .navbar-link {
    color: var(--color-olive);
  }

  .navbar.scrolled .navbar-link:hover,
  .navbar.scrolled .navbar-link.active,
  .navbar:not(.navbar--home) .navbar-link:hover,
  .navbar:not(.navbar--home) .navbar-link.active {
    color: var(--color-sage);
  }

  /* Mobile toggle - always visible by default on mobile */
  .navbar-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    /* Apple HIG minimum tap target: 44x44px */
    width: 2.75rem;
    height: 2.75rem;
    min-width: 44px;
    min-height: 44px;
    gap: 0.375rem;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.375rem;
    border-radius: 0.25rem;
    transition: background-color 0.2s ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  /* Desktop: hide mobile toggle */
  @media (min-width: 1200px) {
    .navbar-toggle {
      display: none !important;
      visibility: hidden;
      width: 0;
      height: 0;
      min-width: 0;
      min-height: 0;
      padding: 0;
      overflow: hidden;
    }
  }

  .hamburger-line {
    display: block;
    width: 1.375rem;
    height: 0.125rem;
    background-color: var(--color-cream-base);
    border-radius: 2px;
    transition: all 0.3s ease;
    transform-origin: center;
  }

  .navbar--home:not(.scrolled) .hamburger-line {
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.65);
  }

  .navbar.scrolled .hamburger-line,
  .navbar:not(.navbar--home) .hamburger-line {
    background-color: var(--color-olive);
  }

  .navbar-toggle.is-open .hamburger-line:nth-child(1) {
    transform: translateY(0.5rem) rotate(45deg);
  }

  .navbar-toggle.is-open .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .navbar-toggle.is-open .hamburger-line:nth-child(3) {
    transform: translateY(-0.5rem) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s ease, background-color 0.3s ease;
  }

  .mobile-menu.is-open {
    display: block;
    max-height: calc(100svh - 4rem);
    overflow-y: auto;
    /* also account for iPhone safe-area at bottom */
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  .navbar--home:not(.scrolled) .mobile-menu {
    background-color: rgba(20, 25, 15, 0.97);
    border-top: 1px solid rgba(250, 246, 240, 0.1);
  }

  .navbar.scrolled .mobile-menu,
  .navbar:not(.navbar--home) .mobile-menu {
    background-color: rgba(250, 246, 240, 0.98);
    border-top: 1px solid var(--color-cream-deep);
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 1rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.875rem 0.75rem;
    font-family: 'Karla', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: rgba(250, 246, 240, 0.85);
    border-bottom: 1px solid rgba(250, 246, 240, 0.08);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: var(--color-cream-base);
    background-color: rgba(250, 246, 240, 0.08);
    padding-left: 1.25rem;
  }

  .navbar.scrolled .mobile-nav-link,
  .navbar:not(.navbar--home) .mobile-nav-link {
    color: var(--color-olive);
    border-bottom-color: var(--color-cream-deep);
  }

  .navbar.scrolled .mobile-nav-link:hover,
  .navbar.scrolled .mobile-nav-link.active,
  .navbar:not(.navbar--home) .mobile-nav-link:hover,
  .navbar:not(.navbar--home) .mobile-nav-link.active {
    color: var(--color-sage);
    background-color: rgba(63, 74, 50, 0.05);
    padding-left: 1.25rem;
  }

  /* ---------- dropdown with icons (Our Service, Wellness Package) ---------- */
  .has-drop {
    position: static;
  }

  /* Invisible bridge so the panel stays open while the mouse moves down to it */
  .has-drop > .navbar-link::before {
    content: '';
    position: absolute;
    left: -1rem;
    right: -1rem;
    top: 100%;
    height: 1.75rem;
  }

  .navbar-caret {
    margin-left: 0.3rem;
    vertical-align: 1px;
    transition: transform 0.2s ease;
  }

  .has-drop:hover .navbar-caret,
  .has-drop:focus-within .navbar-caret {
    transform: rotate(180deg);
  }

  .drop {
    position: absolute;
    left: 50%;
    top: 100%;
    transform: translate(-50%, 8px);
    width: min(1100px, calc(100vw - 3rem));
    padding-top: 0.75rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }

  .has-drop:hover .drop,
  .has-drop:focus-within .drop {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .drop__list {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 2rem 2rem 1.75rem;
    list-style: none;
    background: var(--color-cream-base);
    border-top: 3px solid var(--color-gold);
    box-shadow: 0 18px 40px rgba(31, 42, 34, 0.18);
  }

  .drop__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    width: 11rem;
    padding: 0.5rem;
    text-align: center;
    text-decoration: none;
    white-space: normal;
  }

  .drop__icon {
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    border: 1.5px dotted var(--color-gold);
    border-radius: 50%;
    color: var(--color-gold-dark);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .drop__label {
    font-family: 'Karla', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-olive);
  }

  .drop__item:hover .drop__icon,
  .drop__item:focus-visible .drop__icon {
    background: var(--color-gold);
    color: #fff;
  }

  .mobile-sub {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0 0.5rem 0.75rem;
  }

  .mobile-sub-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.75rem;
    font-family: 'Karla', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: rgba(250, 246, 240, 0.85);
    text-decoration: none;
  }

  .mobile-sub-link svg {
    flex-shrink: 0;
    color: var(--color-gold);
  }

  .navbar.scrolled .mobile-sub-link,
  .navbar:not(.navbar--home) .mobile-sub-link {
    color: var(--color-olive);
  }

  :global(body.menu-open) {
    overflow: hidden;
  }
</style>
